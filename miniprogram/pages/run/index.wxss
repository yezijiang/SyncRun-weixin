/* 去跑页 */

.hd {
  padding: 40rpx 28rpx 8rpx;
}

.hd-t {
  font-size: 46rpx;
  font-weight: 700;
}

.hd-s {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--muted);
}

/* 已加入横幅 */
.joined {
  background: var(--ink);
  border: none;
  color: #fff;
  padding: 32rpx;
}

.j-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.j-tag {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
}

.j-time {
  font-size: 24rpx;
  opacity: 0.8;
}

.j-title {
  margin-top: 18rpx;
  font-size: 34rpx;
  font-weight: 600;
}

.j-stat {
  margin-top: 14rpx;
  font-size: 24rpx;
  opacity: 0.8;
}

.j-acts {
  display: flex;
  gap: 18rpx;
  margin-top: 26rpx;
}

.j-acts .btn {
  flex: 1;
}

.j-acts .btn-ghost {
  background: transparent;
  border-color: rgba(255, 255, 255, 0.4);
  color: #fff;
}

/* 场次列表 */
.slist {
  padding: 0 28rpx;
}

.sitem {
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 26rpx;
  margin-bottom: 18rpx;
}

.si-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.si-time {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--accent);
}

.si-mode {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: var(--bg);
  color: var(--ink-2);
}

.si-t {
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.si-poi {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.si-meta {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--ink-2);
}

.si-meta .sep {
  margin: 0 10rpx;
  color: var(--muted-2);
}

/* 底部 CTA */
.cta-bottom {
  padding: 24rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));
}

/* 表单 */
.lbl {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 18rpx;
}

.lbl .opt {
  margin-left: 10rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: var(--muted-2);
}

.chips {
  white-space: nowrap;
}

.chip {
  display: inline-block;
  padding: 14rpx 28rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  background: var(--bg);
  border: 1rpx solid var(--line-2);
  font-size: 26rpx;
  color: var(--ink-2);
}

.chip.on {
  background: var(--ink);
  border-color: var(--ink);
  color: #fff;
}

.custom {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  border-bottom: 1rpx solid var(--line);
  padding-bottom: 12rpx;
}

.custom .inp {
  flex: 1;
  font-size: 30rpx;
}

.custom .unit {
  font-size: 24rpx;
  color: var(--muted);
}

.hint {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--muted-2);
  line-height: 1.5;
}

/* 时:分:秒 */
.hms {
  display: flex;
  align-items: center;
  justify-content: center;
}

.hms-in {
  width: 140rpx;
  height: 110rpx;
  background: var(--bg);
  border-radius: 20rpx;
  text-align: center;
  font-size: 46rpx;
  font-weight: 600;
}

.colon {
  padding: 0 20rpx;
  font-size: 40rpx;
  color: var(--muted-2);
}

.hms-tip {
  margin-top: 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--muted-2);
}

/* 配速卡 */
.pace-card {
  display: flex;
}

.pc-item {
  flex: 1;
  text-align: center;
}

.pc-l {
  display: block;
  font-size: 22rpx;
  color: var(--muted);
}

.pc-v {
  display: block;
  margin-top: 10rpx;
  font-size: 40rpx;
  font-weight: 700;
}

.pc-v .u {
  font-size: 20rpx;
  font-weight: 400;
  color: var(--muted);
}

/* 截图 */
.shot {
  height: 150rpx;
  border: 2rpx dashed var(--line-2);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--muted);
  font-size: 26rpx;
}

.ta {
  width: 100%;
  height: 150rpx;
  font-size: 28rpx;
}

/* 成功态 */
.done {
  padding: 90rpx 48rpx;
  text-align: center;
}

.done-arc {
  width: 300rpx;
  height: 150rpx;
  margin: 0 auto 40rpx;
  border-radius: 300rpx 300rpx 0 0;
  background: var(--rb);
}

.done-t {
  font-size: 40rpx;
  font-weight: 600;
}

.done-nums {
  display: flex;
  margin-top: 56rpx;
}

.dn {
  flex: 1;
}

.dn-v {
  display: block;
  font-size: 46rpx;
  font-weight: 700;
}

.dn-l {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.done-social {
  margin-top: 48rpx;
  font-size: 26rpx;
  color: var(--ink-2);
}

.done-acts {
  margin-top: 56rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 发起场次表单 */
.pickers {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.pk {
  padding: 16rpx 28rpx;
  border-radius: 16rpx;
  background: #F4F4F6;
  font-size: 28rpx;
  color: #1A1A1F;
}

.poi-btn {
  margin-top: 16rpx;
}

/* 自由跑 */
.free {
  border-style: dashed;
}

.free-t {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1F;
}

.free-s {
  margin: 8rpx 0 24rpx;
  font-size: 24rpx;
  color: #9AA0B4;
}

.back {
  font-size: 26rpx;
  color: #9AA0B4;
  margin-bottom: 12rpx;
}
