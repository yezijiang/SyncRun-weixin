/* 消息中心（UI v2.0） */

.hd {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 24rpx 28rpx 8rpx;
}

.hd-t {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--ink);
}

.hd-x {
  font-size: 24rpx;
  color: #7C5CFF;
}

.list {
  margin: 16rpx 28rpx 0;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  overflow: hidden;
}

.msg {
  display: flex;
  padding: 26rpx 28rpx;
  border-bottom: 1rpx solid var(--line);
}

.msg:last-child {
  border-bottom: none;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #FF4D6D;
  flex: none;
  margin: 12rpx 16rpx 0 0;
}

.msg.read .dot {
  background: transparent;
}

.mt {
  flex: 1;
  min-width: 0;
}

.m-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.m-t {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.m-tag {
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  background: #F0EEFF;
  color: #5B4BA8;
  font-weight: 600;
  flex: none;
}

.m-tm {
  font-size: 20rpx;
  color: var(--muted);
  flex: none;
}

.m-d {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--ink-2);
}

.m-act {
  display: inline-block;
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #7C5CFF;
  border: 1rpx solid #DCD5F7;
  border-radius: 28rpx;
  padding: 8rpx 22rpx;
  background: #FAF8FF;
}

.empty {
  padding: 60rpx 40rpx;
  text-align: center;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--muted);
}

.foot {
  margin-top: 20rpx;
  text-align: center;
  font-size: 20rpx;
  line-height: 1.8;
  color: var(--muted);
}
