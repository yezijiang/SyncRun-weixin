<!-- 消息中心（UI v2.0）：消息能就地处理，不是只能看 -->
<view class="page">

  <view class="hd">
    <view class="hd-t">消息</view>
    <view class="hd-x" bindtap="readAll">全部已读</view>
  </view>

  <view class="list">
    <view class="msg {{item.read ? 'read' : ''}}" wx:for="{{messages}}" wx:key="_id">
      <view class="dot"></view>
      <view class="mt" bindtap="open" data-i="{{index}}">
        <view class="m-top">
          <text class="m-t">{{item.title}}</text>
          <text class="m-tag" wx:if="{{item.type}}">{{typeText[item.type]}}</text>
          <text class="m-tm">{{item.timeText}}</text>
        </view>
        <view class="m-d">{{item.content}}</view>
        <!-- 内联操作：能在这里做完的事，不逼用户跳出去找 -->
        <view
          class="m-act"
          wx:if="{{item.actionText}}"
          catchtap="act"
          data-i="{{index}}"
        >{{item.actionText}}</view>
      </view>
    </view>

    <view class="empty" wx:if="{{!messages.length}}">
      还没有消息。有人给你加油、报名你的场次时会出现在这里
    </view>
  </view>

  <view class="foot">只保留 30 天 · 隐私相关消息不会显示对方任何可识别信息</view>

</view>
