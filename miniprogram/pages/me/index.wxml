<view class="page">

  <!-- 身份区 -->
  <view class="ident">
    <view class="id-av" bindtap="openAvatar">
      <image class="id-img" wx:if="{{avatarFileId}}" src="{{avatarFileId}}" mode="aspectFill" />
      <view
        wx:else
        class="id-grad"
        style="background:linear-gradient(135deg,{{gradient[0]}},{{gradient[1]}})"
      >
        <view class="id-ring"></view>
      </view>
    </view>
    <view class="id-t">
      <view class="id-n">{{nickname}}</view>
      <view class="id-lv">跑者等级 Lv.{{level}}</view>
    </view>
    <view class="id-edit" bindtap="editIdentity">改昵称</view>
  </view>
  <view class="id-tip">
    {{avatarFileId ? '当前是你的微信头像 · 点头像可换回' : '当前是系统生成的头像，不含真实信息'}}
  </view>

  <!-- 头像与昵称 -->
  <view class="mask" wx:if="{{showAvatar}}" catchtap="closeAvatar">
    <view class="av-panel" catchtap="noop">
      <view class="p-t">头像</view>
      <view class="p-s">默认是不含任何真实信息的色块。要用自己的头像也可以，由你决定</view>

      <view class="av-grid">
        <view
          class="av-i {{!avatarFileId && item.join(',') === gradient.join(',') ? 'on' : ''}}"
          wx:for="{{gradients}}"
          wx:key="*this"
          style="background:linear-gradient(135deg,{{item[0]}},{{item[1]}})"
          bindtap="pickGradient"
          data-i="{{index}}"
        ></view>
      </view>

      <view class="av-sep"></view>

      <!--
        微信头像只能由用户主动点选：官方的头像填写能力要求手动确认，
        我们无法在后台静默拉取。这条边界正好是我们想要的——决定权在用户手里。
      -->
      <button
        class="btn btn-ghost av-wx"
        open-type="chooseAvatar"
        bindchooseavatar="onChooseAvatar"
      >使用我的微信头像</button>
      <button
        class="btn btn-ghost av-wx"
        wx:if="{{avatarFileId}}"
        bindtap="revertAvatar"
      >换回生成的头像</button>

      <view class="av-sep"></view>
      <view class="p-t2">昵称</view>
      <!-- type="nickname" 会调起微信的昵称填写键盘，可以直接选用微信昵称 -->
      <input
        class="nick-inp"
        type="nickname"
        placeholder="点这里可以选用你的微信昵称"
        value="{{nickname}}"
        bindinput="onNicknameInput"
      />
      <button class="btn btn-primary av-wx" bindtap="saveNickname">保存昵称</button>
    </view>
  </view>

  <!-- 数据区 -->
  <view class="card nums">
    <view class="n">
      <text class="n-v num">{{totalKm}}</text>
      <text class="n-l">累计公里</text>
    </view>
    <view class="n">
      <text class="n-v num">{{totalCount}}</text>
      <text class="n-l">累计次数</text>
    </view>
    <view class="n">
      <text class="n-v num">{{longest}}</text>
      <text class="n-l">最长单次</text>
    </view>
  </view>

  <!-- 我的足迹 -->
  <view class="sect">
    <text class="t">我的足迹</text>
    <text class="x">地图 ›</text>
  </view>
  <view class="citywrap">
    <view class="citybox" wx:for="{{cities}}" wx:key="city">
      <view class="cb-arc"></view>
      <text class="cb-n">{{item.city}}</text>
    </view>
    <view class="citybox dim">
      <text class="cb-n">未点亮</text>
    </view>
  </view>

  <!-- 成就 -->
  <view class="sect">
    <text class="t">成就</text>
    <text class="x">按累计次数解锁</text>
  </view>
  <view class="ach">
    <view class="a {{item.got ? 'got' : ''}}" wx:for="{{achievements}}" wx:key="code">
      <view class="a-ic"></view>
      <text class="a-n">{{item.name}}</text>
    </view>
  </view>

  <!-- 设置 -->
  <view class="card links">
    <view class="lk" bindtap="openSettings">
      <text>设置与隐私</text>
      <text class="ar">›</text>
    </view>
    <view class="lk" bindtap="openSettings">
      <text>屏蔽名单</text>
      <text class="ar">›</text>
    </view>
    <view class="lk" bindtap="openSettings">
      <text>注销账号与数据清除</text>
      <text class="ar">›</text>
    </view>
  </view>

  <view class="foot">跑起来，遇见同频的人</view>

</view>
