/* 安全中心（UI v2.0） */

.blk {
  margin: 20rpx 28rpx 0;
  padding: 26rpx 28rpx;
  border-radius: 24rpx;
  background: #fff;
  border: 1rpx solid var(--line);
}

.blk.plain {
  padding: 0;
}

.blk-t {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 18rpx;
}

.note {
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--muted);
}

.picks {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.pick {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 16rpx;
  background: #F4F4F6;
  font-size: 22rpx;
  color: var(--ink-2);
}

.pick.on {
  background: #F0EEFF;
  color: #5B4BA8;
  font-weight: 600;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid var(--line);
}

.row:last-child {
  border-bottom: none;
}

.rl {
  flex: 1;
  min-width: 0;
  padding-right: 20rpx;
}

.rt {
  font-size: 26rpx;
  color: var(--ink);
}

.rs {
  display: block;
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--muted);
  line-height: 1.5;
}

.ghost-btn {
  margin-top: 20rpx;
}

.sect {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 28rpx 28rpx 8rpx;
}

.sect .t {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
}

.sect .x {
  font-size: 22rpx;
  color: var(--muted);
}

.bl {
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx;
  border-bottom: 1rpx solid var(--line);
}

.bl:last-child {
  border-bottom: none;
}

.av {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  flex: none;
}

.bl-n {
  flex: 1;
  margin-left: 20rpx;
  font-size: 26rpx;
  color: var(--ink);
}

.bl-btn {
  font-size: 24rpx;
  color: #7C5CFF;
}

.empty {
  padding: 48rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--muted);
}

.foot {
  margin: 32rpx 40rpx 40rpx;
  text-align: center;
  font-size: 20rpx;
  line-height: 1.8;
  color: var(--muted);
  white-space: pre-line;
}
