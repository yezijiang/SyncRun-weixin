<view class="page">

  <view class="hd">
    <view class="hd-t">动态</view>
    <view class="hd-s">社区内可见 · 默认不同步到任何外部平台</view>
  </view>

  <view class="post" wx:for="{{posts}}" wx:key="_id">
    <view class="ph">
      <image class="av" wx:if="{{item.author.avatar}}" src="{{item.author.avatar}}" mode="aspectFill" bindtap="goProfile" data-id="{{item.author.id}}" />
      <view
        class="av"
        wx:else
        style="background:linear-gradient(135deg,{{item.author.gradient[0]}},{{item.author.gradient[1]}})"
        bindtap="goProfile"
        data-id="{{item.author.id}}"
      ></view>
      <view class="ph-t">
        <view class="ph-n">{{item.author.nickname}}</view>
        <view class="ph-m">{{item.timeText}} · {{item.author.city || '深圳'}}</view>
      </view>
      <view class="more" bindtap="more" data-id="{{item._id}}">···</view>
    </view>

    <!-- 打卡动态带数据卡：数字全部来自这一次打卡，不写死 -->
    <view class="data" wx:if="{{item.type === 'checkin' && item.checkin}}">
      <text class="num">{{item.kmText}}</text><text class="u">KM</text>
      <text class="dot">·</text>
      <text class="num">{{item.durText}}</text>
      <text class="dot">·</text>
      <text class="num">{{item.paceText}}</text>
    </view>

    <view class="body">{{item.content}}</view>

    <view class="acts">
      <view class="act {{cheered[item._id] ? 'on' : ''}}" bindtap="cheer" data-id="{{item._id}}">
        <view class="heart"></view>
        <text class="num">{{item.cheer_count || 0}}</text>
      </view>
      <view class="act" bindtap="comment" data-id="{{item._id}}">
        <view class="bubble"></view>
        <text class="num">{{item.comment_count || 0}}</text>
      </view>
    </view>

    <!-- 最近评论（UI v2.0）：先看到别人说了什么，再决定自己要不要说 -->
    <view class="cmts" wx:if="{{item.comments.length}}">
      <view class="cmt" wx:for="{{item.comments}}" wx:for-item="c" wx:key="_id">
        <text class="cmt-n">{{c.author.nickname}}</text>
        <text class="cmt-t">{{c.text}}</text>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{!posts.length}}">还没有动态，今天的第一个由你来发</view>

  <view class="foot">「鼓励」代替点赞 · 不自建排行榜 · 不做跨用户配速比较</view>

</view>
